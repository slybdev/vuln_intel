# vuln-intel environment file
# Copy to .env, fill in what you need, and keep .env out of git (it is in .gitignore).
# Every variable is OPTIONAL: with none set, the pipeline still runs using the defaults shown.
# Format: KEY=value, no spaces around "=", no quotes needed.

# --- API credentials (only raise rate limits) ---------------------------------------------
# Free key: https://nvd.nist.gov/developers/request-an-api-key
# Without it NVD throttles heavily and the run is much slower.
NVD_API_KEY=

# Fine-grained personal access token with NO permissions, public repositories read-only.
# Not required: the advisories endpoint works unauthenticated, the token just lifts the rate limit.
GITHUB_TOKEN=

# --- Output location ----------------------------------------------------------------------
# Where raw data, reports, state and logs are written. Default: ./vuln_data
VULN_DATA_DIR=./vuln_data

# --- PostgreSQL ---------------------------------------------------------------------------
# Start the local database with: docker compose up -d postgres
# Set this in the environment of the Python process that runs main.py.
VULN_DATABASE_URL=postgresql://vulnintel:vulnintel@127.0.0.1:5432/vulnintel
POSTGRES_DB=vulnintel
POSTGRES_USER=vulnintel
POSTGRES_PASSWORD=vulnintel
POSTGRES_PORT=5432

# --- External inventory / GitLab CI integration -----------------------------------------
# Allow only the Git provider hosts that the scan worker should contact.
VULN_REPOSITORY_HOSTS=github.com,gitlab.com,gitlab.internal.example
# Bearer token required for authenticated scan-trigger API requests.
VULN_SCAN_API_TOKEN=
# Stable Fernet key used to encrypt saved Git provider credentials.
VULN_REPOSITORY_ENCRYPTION_KEY=
# Shared bearer token used by the external inventory only for repository registration.
VULN_INVENTORY_API_TOKEN=
# Public HTTPS origin (and optional path prefix) returned as the GitLab CI scan trigger URL.
VULN_PUBLIC_API_BASE_URL=https://scanner.example.com
# Exact HTTPS hostnames allowed for result callbacks; set in the dashboard and scan worker.
VULN_INVENTORY_CALLBACK_HOSTS=inventory.example.com

# --- What to collect ----------------------------------------------------------------------
# OSV ecosystems to follow (comma separated, no spaces). Trim to what you actually run.
OSV_ECOSYSTEMS=PyPI,npm,Go,Maven,crates.io,NuGet,RubyGems,Packagist

# GitHub advisory types: any of reviewed, unreviewed, malware (comma separated).
GHSA_TYPES=reviewed

# --- Window behaviour ---------------------------------------------------------------------
# How far back the very first run looks (hours). Later runs continue from the last success.
FIRST_RUN_LOOKBACK_HOURS=24

# Each run re-pulls this many hours before the last success to catch late edits (hours).
OVERLAP_HOURS=6

# --- Network (uncomment if your environment needs a proxy) --------------------------------
# HTTPS_PROXY=http://proxy.example.local:8080
# HTTP_PROXY=http://proxy.example.local:8080
# NO_PROXY=localhost,127.0.0.1
